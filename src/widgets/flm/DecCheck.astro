---
/**
 * 分層證明裡的小標記：證明推出某個節點「必須」決定 forced，這裡顯示讀者在上方互動圖「排練」時替該節點填的值，
 * 不符就標紅、相符標 ✓、還沒填就不顯示。資料來自 controller.ts 在每次重畫時送出的 `flm-dec` 事件。
 * 用法（只能放在 MDX 裡）：<DecCheck kind="triangle" node="v" forced="0" />
 *   三角形圖的節點是 u v w x y z；牆圖的節點是 A0 B0 C0 D0 A1 B1 C1 D1（label 可指定顯示用的 A₀）。
 */
interface Props {
  kind: 'triangle' | 'wall';
  node: string;
  forced: '0' | '1';
  label?: string;
}
const { kind, node, forced, label } = Astro.props;
const lang = Astro.locals.starlightRoute.lang?.startsWith('en') ? 'en' : 'zh-TW';
const text = lang === 'en' ? 'your fill' : '你填的';
---

<span class="flm-deccheck" data-kind={kind} data-node={node} data-forced={forced} data-label={label ?? node} data-text={text} hidden></span>

<style is:global>
  .flm-deccheck {
    margin-inline-start: 0.5em;
    padding: 0 0.5em;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 1em;
    font-size: 0.78em;
    font-weight: 500;
    white-space: nowrap;
    color: var(--sl-color-gray-2);
  }
  .flm-deccheck[hidden] { display: none; }
  .flm-deccheck.bad { border-color: var(--bft-fault); color: var(--bft-fault); font-weight: 700; }
</style>

<script>
  type Dec = '?' | '0' | '1';
  const store: Record<string, Record<string, Dec>> = ((window as any).__flmDec ||= {});
  function paint() {
    document.querySelectorAll<HTMLElement>('.flm-deccheck').forEach((el) => {
      const d = store[el.dataset.kind!]?.[el.dataset.node!];
      if (!d || d === '?') { el.hidden = true; return; }
      const bad = d !== el.dataset.forced;
      el.hidden = false;
      el.classList.toggle('bad', bad);
      el.textContent = `${el.dataset.text} ${el.dataset.label} = ${d} ${bad ? '✗' : '✓'}`;
    });
  }
  document.addEventListener('flm-dec', (e) => {
    const { kind, dec } = (e as CustomEvent).detail;
    store[kind] = dec;
    paint();
  });
  paint();
</script>
