---
import { renderInline } from '../lib/inline-math';
const lang = Astro.locals.starlightRoute.lang?.startsWith('en') ? 'en' : 'zh';
const L = (zh: string, en: string) => (lang === 'en' ? en : zh);
/**
 * Lamport 式分層證明的外框。
 * 內容由 <Step> 組成，Step 可以巢狀；有內容的 Step 可摺疊，沒有內容的是一行葉節點。
 * 編號由 CSS counter 自動產生（1、2、2.1、2.2…），不需手寫。
 * 工具列：「全部展開」「只看骨架」（收合全部）。
 *
 * assumes：整段證明依賴的假設（一行）。
 */
interface Props {
  assumes?: string;
}
const { assumes } = Astro.props;
---

<div class="sproof">
  <div class="sproof-head">
    <span class="sproof-title"><strong>{L('證明（分層）.', 'Structured proof.')}</strong></span>
    {assumes && <span class="sproof-assumes">{L('依賴：', 'Depends on: ')}<Fragment set:html={renderInline(assumes)} /></span>}
    <span class="sproof-tools">
      <button type="button" data-sproof="expand">{L('全部展開', 'Expand all')}</button>
      <button type="button" data-sproof="collapse">{L('只看骨架', 'Skeleton only')}</button>
    </span>
  </div>
  <div class="sproof-steps"><slot /></div>
  <div class="sproof-qed" aria-hidden="true">∎</div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.sproof').forEach((root) => {
    const setAll = (open: boolean) =>
      root.querySelectorAll<HTMLDetailsElement>('details.sstep').forEach((d) => (d.open = open));
    root
      .querySelector('[data-sproof="expand"]')
      ?.addEventListener('click', () => setAll(true));
    root
      .querySelector('[data-sproof="collapse"]')
      ?.addEventListener('click', () => setAll(false));
  });
</script>

<style>
  .sproof {
    margin: 0.5rem 0 1.5rem;
    padding: 0.75rem 0.9rem 0.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--sl-color-bg-nav);
  }
  .sproof-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    margin-bottom: 0.5rem;
  }
  .sproof-assumes {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .sproof-tools {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-inline-start: auto;
  }
  .sproof-tools button {
    margin: 0; /* 擋掉 Starlight 對相鄰元素自動加的 margin-top */
    padding: 0.15rem 0.6rem;
    font: inherit;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-2);
    background: transparent;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    cursor: pointer;
  }
  .sproof-tools button:hover {
    color: var(--sl-color-white);
    border-color: var(--sl-color-gray-3);
  }
  .sproof-tools button:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
  .sproof-steps {
    overflow-x: auto;
    counter-reset: sstep;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .sproof-qed {
    text-align: right;
    color: var(--sl-color-gray-3);
  }
</style>
