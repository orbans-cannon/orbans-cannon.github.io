---
/**
 * 「想一想」自我檢查：一題問題，答案預設收合，讀者點開才看到。
 * 題目要逼讀者用到剛讀的定義；答案只能寫正文已經寫明的內容。每頁 1–3 題。
 * 用法：
 *   <Check q="為什麼被網路延遲的誠實節點不算故障？">
 *   答案（Markdown，可含 $…$）
 *   </Check>
 * q 可含 $…$（props 不經過 remark-math，用 renderInline 渲染）。
 * 規則見 design.md §想一想。
 */
import { renderInline } from '../lib/inline-math';

interface Props {
  /** 問題（一句話，可含 $…$） */
  q: string;
}
const { q } = Astro.props;
const lang = Astro.locals.starlightRoute.lang?.startsWith('en') ? 'en' : 'zh';
const L = (zh: string, en: string) => (lang === 'en' ? en : zh);
---

<details class="bft-check">
  <summary>
    <span class="bft-check-label">{L('想一想', 'Think')}</span>
    <span class="bft-check-q" set:html={renderInline(q)} />
    <span class="bft-check-hint">{L('看答案', 'Show answer')}</span>
  </summary>
  <div class="bft-check-a"><slot /></div>
</details>

<style is:global>
  /* 不是卡片：上下細線＋一行問題；摘要列可以點，所以用金色（design.md §顏色系統：金＝可以點）。
     Starlight 會替內容區的 details 加內距、邊框與背景，這裡重設（衝突清單 #2）。 */
  .sl-markdown-content details.bft-check {
    margin: 1.75rem 0;
    padding: 0;
    border: 0;
    border-block: 1px solid var(--sl-color-hairline);
    border-radius: 0;
    background: none;
  }
  .bft-check > summary {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    padding: 0.7rem 0;
    cursor: pointer;
    list-style: none;
  }
  .bft-check > summary::-webkit-details-marker,
  .sl-markdown-content .bft-check > summary::before {
    display: none;
  }
  .bft-check-label {
    flex: none;
    font-weight: 700;
    color: var(--bft-gold);
  }
  .bft-check-q {
    flex: 1 1 16rem;
    min-width: 0;
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .bft-check-hint {
    flex: none;
    margin-inline-start: auto;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .bft-check-hint::after {
    content: ' ▸';
    display: inline-block;
    transition: transform 0.15s ease;
  }
  .bft-check[open] .bft-check-hint::after {
    transform: rotate(90deg);
  }
  .bft-check > summary:hover .bft-check-hint {
    color: var(--bft-gold);
  }
  .bft-check > summary:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
  .bft-check-a {
    margin: 0 0 0.9rem;
    padding-left: 1rem;
    border-left: 2px dashed var(--sl-color-gray-4);
  }
  .sl-markdown-content .bft-check-a > :first-child {
    margin-top: 0;
  }
</style>
