---
/**
 * 覆寫 Starlight 的站名：大砲小圖示（與 favicon 同造型、改成金色單色）＋宋體金色站名，
 * 寬螢幕時右邊加一行灰色小字說明網站主題（站名是典故，看不出主題）。
 */
const { siteTitle, siteTitleHref, lang } = Astro.locals.starlightRoute;
const tagline = lang?.startsWith('en') ? 'A theory guide to Byzantine fault tolerance' : '拜占庭容錯理論導讀';
---

<a href={siteTitleHref} class="bft-site-title">
  <svg class="bft-logo" viewBox="10 8 110 108" aria-hidden="true">
    <g transform="translate(4 -7)">
      <path d="M12 116 L100 116 L100 104 L12 112 Z" />
      <g transform="rotate(-24 54 84)">
        <rect x="6" y="73" width="30" height="24" rx="5" />
        <rect x="30" y="64" width="58" height="42" rx="6" />
        <rect class="cut" x="45" y="64" width="4" height="42" />
        <rect class="cut" x="66" y="64" width="4" height="42" />
        <ellipse cx="90" cy="85" rx="6.5" ry="22" />
        <ellipse class="cut" cx="91" cy="85" rx="3" ry="11" />
      </g>
    </g>
    <circle cx="108" cy="22" r="10" />
  </svg>
  <span class="name" translate="no">{siteTitle}</span>
</a>
<span class="bft-site-tagline" aria-hidden="true">{tagline}</span>

<style>
  .bft-site-title {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    min-width: 0;
    color: var(--bft-gold);
    text-decoration: none;
    white-space: nowrap;
  }
  .bft-logo {
    flex: none;
    width: 1.9rem;
    height: 1.9rem;
    fill: currentColor;
    transition: transform 200ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  .bft-logo .cut {
    fill: var(--sl-color-bg-nav);
  }
  .name {
    overflow: hidden;
    font-family: var(--bft-serif);
    font-size: var(--sl-text-h4);
    font-weight: 700;
    letter-spacing: 0.06em;
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .bft-site-title:hover .bft-logo {
      transform: rotate(-6deg) translateX(-1px);
    }
  }
  .bft-site-title:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 3px;
    border-radius: 0.25rem;
  }
  .bft-site-tagline {
    display: none;
    align-self: center;
    line-height: 1.2;
    margin-inline-start: 0.9rem;
    padding-inline-start: 0.9rem;
    border-inline-start: 1px solid var(--sl-color-gray-5);
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
    white-space: nowrap;
  }
  @media (min-width: 72rem) {
    .bft-site-tagline {
      display: inline;
    }
  }
</style>
